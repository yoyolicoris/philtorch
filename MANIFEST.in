# setuptools_scm already adds every git-tracked file, including the vendored
# sources under third_party/. This file adds the package's build inputs and
# drops what neither building nor testing from the sdist needs.

recursive-include philtorch *.txt *.h *.cpp *.cuh *.cu *.mm
include README.md build_support.py

# Development-only files. tests/ stays, along with the scripts and matrix file
# that the build-tooling tests load.
prune .github
prune benchmarks
prune examples
exclude .gitattributes .gitignore
exclude pixi.toml pixi.lock CONTRIBUTING.md scripts/run-limited
